# dash>=2.14.0,<3.0.0

# dash-bootstrap-components: Bootstrap components for Dash
# dash-bootstrap-components>=1.5.0,<2.0.0

# plotly: Interactive visualization library
# plotly>=5.18.0,<6.0.0

# gunicorn: Production WSGI server for deploying Dash
# gunicorn>=21.2.0,<22.0.0

# --- TESTING (Optional but recommended) ---

# pytest: Testing framework
# pytest>=7.4.0,<8.0.0

# pytest-cov: Code coverage reports
# pytest-cov>=4.1.0,<5.0.0

# --- AWS INTEGRATION (Optional - for Lambda deployment) ---

# boto3: AWS SDK for Python
# boto3>=1.34.0,<2.0.0

# ============================================================================
# DEVELOPMENT vs PRODUCTION
# ============================================================================
#
# For production, you might want separate files:
#
# requirements-base.txt (core dependencies)
# requirements-dev.txt (testing, linting)
# requirements-prod.txt (gunicorn, AWS tools)
#
# Then:
#   pip install -r requirements-base.txt
#   pip install -r requirements-dev.txt  # only on your laptop
#
# ============================================================================

# ============================================================================
# TROUBLESHOOTING
# ============================================================================
#
# "ERROR: No matching distribution found for X"
#   → Check Python version (need 3.9+)
#   → Try: pip install --upgrade pip
#
# "ERROR: Could not build wheels for Y"
#   → Missing system dependencies
#   → Ubuntu: sudo apt-get install python3-dev build-essential
#   → Mac: xcode-select --install
#
# "ImportError: No module named X"
#   → Virtual environment not activated
#   → Or didn't install requirements
#
# ============================================================================